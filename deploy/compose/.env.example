# Non-secret Compose interpolation only. Copying this file does not create the
# secret files referenced below.
POSTGRES_DB=share_disk
POSTGRES_USER=share_disk
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
POSTGRESQL_URL_FILE=./secrets/postgresql_url
BOOTSTRAP_TOKEN_FILE=./secrets/bootstrap_token
ACCESS_PRIVATE_KEY_FILE=./secrets/access_private_key
CONTROL_SERVER_BIND_ADDRESS=127.0.0.1
CONTROL_SERVER_PORT=8080

# Only used by the test-only compose.agent-test.yaml overlay. The production
# default Compose does not run the Agent; real Ubuntu hosts install the Agent
# via the .deb package and manage it with systemd.
ACCESS_PUBLIC_KEY_FILE=./secrets/access_public_key
LAN_AGENT_BIND_ADDRESS=127.0.0.1
LAN_AGENT_PORT=9090
LAN_MAX_UPLOAD_SIZE=10737418240

# The secret files referenced above contain real values and must never be
# committed. Generate each with a strong random value, e.g.:
#   openssl rand -hex 32
# The postgresql_url secret file contains the full DSN until the application
# supports independently mounted password fields.
