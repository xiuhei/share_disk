#!/bin/sh
set -e

#DEBHELPER#

case "$1" in
    purge)
        # Purging is the explicit, destructive data-removal operation. A normal
        # remove/upgrade keeps the object bytes and SQLite so a reinstall or
        # upgrade never deletes user files implicitly.
        rm -rf /etc/share-disk
        rm -rf /var/lib/share-disk
        # Leave the system account in place; reinstallation recreates it.
        ;;
    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        ;;
esac

exit 0
