# Share Disk Agent runtime configuration.
#
# All paths and the LAN data plane are configured here. Keep secret values in a
# separate root-only file and reference them via the *_FILE form; never put
# secrets in a file that is readable by other local users.

# Local object bytes (authoritative local storage root).
SHARE_DISK_STORAGE_ROOT=/var/lib/share-disk/objects

# Local metadata database (SQLite).
SHARE_DISK_SQLITE_PATH=/var/lib/share-disk/agent.db

# Unix-socket IPC path used by share-disk-cli.
SHARE_DISK_AGENT_SOCKET=/run/share-disk/agent.sock

# Bundled SQLite migrations shipped with the package.
SHARE_DISK_SQLITE_MIGRATIONS_DIR=/usr/lib/share-disk/migrations/sqlite

# Opt-in LAN data plane for Android uploads/downloads. Disabled by default so a
# freshly installed agent never listens on the network implicitly.
SHARE_DISK_LAN_ENABLED=false
SHARE_DISK_LAN_HOST=127.0.0.1
SHARE_DISK_LAN_PORT=9090
SHARE_DISK_LAN_MAX_UPLOAD_SIZE=10737418240
SHARE_DISK_TRASH_RETENTION=168h
# Enable on a host LAN after setting SHARE_DISK_LAN_HOST=0.0.0.0. Bridged
# containers need explicit multicast support; manual Agent addresses still work.
SHARE_DISK_LAN_DISCOVERY_ENABLED=false

# Set both values to enable durable account-wide catalog coordination. The
# advertise URL must be reachable by Android clients; do not use 0.0.0.0 here.
# SHARE_DISK_CONTROL_URL=https://share-disk.example.test
# SHARE_DISK_LAN_ADVERTISE_URL=http://192.168.1.20:9090
SHARE_DISK_SYNC_INTERVAL=2s

# Local Ubuntu browser client. It is deliberately restricted to loopback and
# is available at http://127.0.0.1:9191 after installation.
SHARE_DISK_DESKTOP_UI_ENABLED=true
SHARE_DISK_DESKTOP_UI_HOST=127.0.0.1
SHARE_DISK_DESKTOP_UI_PORT=9191

# Logging.
SHARE_DISK_LOG_LEVEL=info
SHARE_DISK_LOG_FORMAT=json
SHARE_DISK_LOG_OUTPUT=stdout

# Access-token verification material for the LAN data plane. This is the public
# key of the control server's Ed25519 signing key; the Agent must never receive
# the server's private key. Set this after registering the device.
# SHARE_DISK_ACCESS_PUBLIC_KEY_FILE=/etc/share-disk/secrets/access_public_key
