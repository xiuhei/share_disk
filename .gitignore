# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
/conf/server.json
/conf/.runtime/


# Go build and test outputs
/build/
/bin/
# Legacy local output; new artifacts use release/.
/dist/
/coverage/
*.test
*.out
coverage*.txt
coverage*.html
/vendor/

# Generated runtime data (never source packages)
/data/
/var/
/logs/
/tmp/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.part

# Android and native build outputs
.gradle/
**/build/
local.properties
*.apk
*.aab
.externalNativeBuild/
.cxx/

# Versioned release artifacts. Keep only the directory contract in Git.
/release/android/*
!/release/android/.gitkeep
/release/ubuntu/*
!/release/ubuntu/.gitkeep
/release/windows/*
!/release/windows/.gitkeep

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.~*

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini
